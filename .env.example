# Copy to .env and fill in your own values. Never commit .env.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model used by default (must be visible to your key)
GEMINI_MODEL=gemini-3.1-flash-lite

# Embedding model used to build the chat index (RAG)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chunking and generation knobs (optional, these are the defaults)
# CHUNK_SIZE=4000
# CHUNK_OVERLAP=200
# TEMPERATURE=0.2
# MAX_OUTPUT_TOKENS=2048
# OCR_ENABLED=true
# OCR_MAX_PAGES=20
